# Copy this file to backend/.env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL=mysql+pymysql://bonnco:bonnco_pw@localhost:3307/bonnco

# --- Binance ---
# No API key required for public market data (spot + futures REST/WebSocket)
BINANCE_SPOT_BASE_URL=https://api.binance.com
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
# Optional: read-only account key (generate in Binance API Management with ONLY "Enable Reading"
# checked). Leave blank to instead paste it into Settings in the app.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# --- Exchange adapter selection (future-proofing for Bybit) ---
EXCHANGE_PROVIDER=binance

# --- Whale tracking (Ethereum) ---
# Free tier, get one at https://etherscan.io/apis — Ethereum whale tracking stays inactive without it.
ETHERSCAN_API_KEY=

# --- AI providers ---
AI_PROVIDER=openai
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- App ---
APP_ENV=development
RISK_PROFILE=moderate
